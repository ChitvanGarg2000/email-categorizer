# Google OAuth credentials (from Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback
# Production example: https://your-backend.up.railway.app/auth/callback

# Local Ollama server for LLM-based classification (ollama.com)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# LLM provider: "openrouter" (hosted), "ollama" (local), or "gemini"
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-your-key
OPENROUTER_MODEL=minimax/minimax-m3:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Only sync unread inbox mail from the last N days (0 = no date filter)
GMAIL_SYNC_DAYS=14

# Session/cookie signing secret - generate any random string
SECRET_KEY=change-this-to-a-random-secret-string

# Where the frontend runs, used for post-login redirect + CORS
FRONTEND_URL=http://localhost:3000
# Production example: https://your-app.vercel.app

# Local: sqlite:///./app.db
# Production (Railway volume mounted at /data): sqlite:////data/app.db
DATABASE_URL=sqlite:///./app.db
